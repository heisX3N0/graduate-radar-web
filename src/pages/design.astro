---
// /design: the Graduate Radar design system (direction A, Noticeboard; owner decision
// 15 Nov 2026; rows, facts table and ruled notices from GR-015 and GR-016). Every token and every component in every state.
// Not linked from the site and not indexed.
import tokensCss from '../styles/tokens.css?raw';
import ApplyButton from '../components/ApplyButton.astro';
import Banner from '../components/Banner.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import EligibilityChecklist from '../components/EligibilityChecklist.astro';
import EmptyState from '../components/EmptyState.astro';
import FactsTable from '../components/FactsTable.astro';
import FilterBar from '../components/FilterBar.astro';
import FilterChip from '../components/FilterChip.astro';
import ListHead from '../components/ListHead.astro';
import { absolute } from '../lib/site.ts';
import ListingRow from '../components/ListingRow.astro';
import ListSection from '../components/ListSection.astro';
import ResultCount from '../components/ResultCount.astro';
import SafetyNote from '../components/SafetyNote.astro';
import SearchInput from '../components/SearchInput.astro';
import Select from '../components/Select.astro';
import ShareButton from '../components/ShareButton.astro';
import { getListings, type JobListing, type TrainingListing } from '../data/feed.ts';
import Base from '../layouts/Base.astro';
import { lagosToday, shortDate } from '../lib/dates.ts';
import { checkedFact, closesFact, eligibilityItems, placeText } from '../lib/listing-text.ts';

const { jobs, trainings, generatedAt } = await getListings();
const today = lagosToday();
const dataDay = Number.isNaN(Date.parse(generatedAt)) ? '' : lagosToday(new Date(generatedAt));

// Days relative to today, for example states that do not depend on today's feed.
const inDays = (n: number) => {
  const d = new Date(`${today}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
};

// A real job as the base, then one example per state the components must handle.
// If the data has no jobs at all, a built-in example keeps the build from failing.
const EXAMPLE_JOB: JobListing = {
  key: 'example|graduate trainee programme|2026',
  slug: 'example-graduate-trainee-programme-2026',
  firstSeen: today,
  organisation: 'Example Company Nigeria',
  title: 'Graduate Trainee Programme',
  type: 'Graduate Trainee',
  field: 'Any discipline',
  location: 'Lagos',
  remote: false,
  eligibility: 'Any discipline',
  minClass: '2:1',
  maxAge: '26',
  nysc: 'Required done',
  deadline: 'Not stated',
  applyLink: 'https://example.com/careers',
  verifiedOn: today,
  status: 'Open',
  notes: '',
};
const realJob: JobListing =
  jobs.find((j) => j.minClass === '2:1' && j.maxAge !== '') ?? jobs[0] ?? EXAMPLE_JOB;
const jobStates: { label: string; listing: JobListing }[] = [
  {
    label: 'Closing within 7 days',
    listing: { ...realJob, deadline: inDays(4), firstSeen: inDays(-1) },
  },
  {
    label: 'Open, far deadline',
    listing: { ...realJob, deadline: inDays(20), firstSeen: inDays(-30) },
  },
  { label: 'Closes today', listing: { ...realJob, deadline: today, firstSeen: inDays(-30) } },
  {
    label: 'Remote, deadline not stated',
    listing: {
      ...realJob,
      remote: true,
      deadline: 'Not stated',
      minClass: 'Not stated',
      maxAge: '',
      nysc: 'Not stated',
      firstSeen: inDays(-30),
    },
  },
  {
    label: 'Rolling deadline',
    listing: { ...realJob, deadline: 'Rolling', firstSeen: inDays(-30) },
  },
  {
    label: 'Closed (deadline passed)',
    listing: { ...realJob, deadline: inDays(-3), firstSeen: inDays(-30) },
  },
];
const realTraining: TrainingListing | undefined = trainings[0];

const colours = [...tokensCss.matchAll(/--(color-[a-z-]+):\s*(#[0-9a-f]{6})/gi)].map((m) => ({
  name: m[1]!,
  hex: m[2]!,
}));
const sizes = ['xs', 'sm', 'body', 'md', 'lg', 'xl', '2xl'];
const spaces = [1, 2, 3, 4, 6, 8, 12];
const sortOptions = [
  { value: 'soon', label: 'Closing soonest' },
  { value: 'new', label: 'Newest' },
];
---

<Base
  title="Design system"
  description="Graduate Radar design system: tokens and components."
  noindex
>
  <div class="ds">
    <section class="ds__intro">
      <p class="ds__eyebrow">Design system</p>
      <h1>Noticeboard</h1>
      <p>
        The vacancies page of a newspaper you trust, made for a phone. Chosen by the owner on 15 Nov
        2026, with a quiet "Checked" stamp on every card. Every colour, size and space below is a
        token in <code>src/styles/tokens.css</code>; components may use nothing else (checked on
        every build). Data from {shortDate(dataDay) || 'an unknown date'}.
      </p>
    </section>

    <section class="ds__section" aria-labelledby="colour-h">
      <h2 id="colour-h">Colour</h2>
      <p class="ds__note">
        Text pairs meet 7:1 for body text and 4.5:1 for everything else (tests/tokens.test.ts), for
        reading in sunlight.
      </p>
      <ul class="ds__swatches">
        {colours.map((c) => (
          <li>
            <span class="ds__chip" style={`background: var(--${c.name})`} />
            <span>
              <code>--{c.name}</code> {c.hex}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ds__section" aria-labelledby="type-h">
      <h2 id="type-h">Type</h2>
      <p class="ds__note">Phone fonts only: serif for headlines, sans for text. 0 KB downloaded.</p>
      {sizes.map((s) => (
        <p class="ds__type" style={`font-size: var(--font-size-${s})`}>
          <code>--font-size-{s}</code> Graduate trainee programme
        </p>
      ))}
      <p class="ds__display">Display: Deloitte Academy Cyber Security Programme</p>
    </section>

    <section class="ds__section" aria-labelledby="space-h">
      <h2 id="space-h">Space</h2>
      <p class="ds__note">A 4 px base.</p>
      {spaces.map((n) => (
        <p class="ds__space">
          <span class="ds__bar" style={`width: var(--space-${n})`} />
          <code>--space-{n}</code>
        </p>
      ))}
    </section>

    <section class="ds__section" aria-labelledby="hero-h">
      <h2 id="hero-h">List page heading</h2>
      <ListHead
        heading="Graduate jobs"
        count={jobs.length}
        noun="opening"
        source="employer"
        updated={dataDay}
      />
    </section>

    <section class="ds__section" aria-labelledby="facts-h">
      <h2 id="facts-h">Facts table</h2>
      <p class="ds__note">
        The top of a detail page: Closes, Where, Checked. No badges, boxed deadline or stamp. Closes
        is red within 7 days and when closed. A missing or impossible Checked date leaves the row
        out.
      </p>
      <div class="ds__stack">
        {jobStates.map((s) => (
          <div class="ds__labelled ds__wide">
            <span class="ds__label">{s.label}</span>
            <FactsTable
              closes={closesFact(s.listing, today)}
              where={placeText(s.listing.location, s.listing.remote)}
              checked={checkedFact(s.listing.verifiedOn, 'employer')}
            />
          </div>
        ))}
        <div class="ds__labelled ds__wide">
          <span class="ds__label">No Checked date</span>
          <FactsTable
            closes={closesFact(realJob, today)}
            where={realJob.location}
            checked={checkedFact('', 'employer')}
          />
        </div>
      </div>
    </section>

    <section class="ds__section" aria-labelledby="row-h">
      <h2 id="row-h">List rows and sections</h2>
      <p class="ds__note">
        List pages group rows under ruled section headers with a count. Red only on "Closes today"
        and "Next 7 days". A row has no badges, stamp or boxed deadline; the whole row links to the
        detail page. Newest is one flat list with no headers. An empty section is hidden.
      </p>
      <div class="ds__list">
        <ListSection id="ds-today" label="Closes today" urgent count={1}>
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: today }} />
          </li>
        </ListSection>
        <ListSection id="ds-week" label="Next 7 days" urgent count={1}>
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: inDays(4) }} />
          </li>
        </ListSection>
        <ListSection id="ds-later" label="Later" urgent={false} count={1}>
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: inDays(20) }} />
          </li>
        </ListSection>
        <ListSection id="ds-open" label="Rolling or no date" urgent={false} count={2}>
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: 'Rolling' }} />
          </li>
          <li>
            <ListingRow
              kind="job"
              listing={{
                ...realJob,
                remote: true,
                deadline: 'Not stated',
                minClass: 'Not stated',
                maxAge: '',
                nysc: 'Not stated',
              }}
            />
          </li>
        </ListSection>
        {realTraining && (
          <ListSection id="ds-track" label={realTraining.track} urgent={false} count={1}>
            <li>
              <ListingRow kind="training" listing={realTraining} />
            </li>
          </ListSection>
        )}
        <span class="ds__label">Newest: one flat list, no section headers</span>
        <ul class="ds__flat">
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: inDays(20) }} />
          </li>
          <li>
            <ListingRow kind="job" listing={{ ...realJob, deadline: 'Rolling' }} />
          </li>
        </ul>
      </div>
    </section>

    <section class="ds__section" aria-labelledby="detail-h">
      <h2 id="detail-h">Detail page parts</h2>
      <div class="ds__stack">
        <Breadcrumb items={[{ label: 'Jobs', href: '/' }, { label: realJob.title }]} />
        <Banner kind="closed" title="This opening has closed">
          <p>Here are similar openings that are still open.</p>
        </Banner>
        <Banner kind="warning" title="Asked to pay a fee?">
          <p>Stop. Real employers never charge to apply.</p>
        </Banner>
        <Banner kind="info" title="Details can change">
          <p>Always confirm on the organisation's own page before you apply.</p>
        </Banner>
        <span class="ds__label">Eligibility, stated and not stated</span>
        <EligibilityChecklist items={eligibilityItems(realJob)} />
        <EligibilityChecklist items={[]} />
        <span class="ds__label">Apply: web, email, and a refused link</span>
        <ApplyButton href={realJob.applyLink} />
        <ApplyButton href="mailto:careers@example.com" />
        <ApplyButton href="javascript:alert(1)" />
        <ShareButton
          title={realJob.title}
          organisation={realJob.organisation}
          deadline={realJob.deadline}
          url={absolute(Astro.site, `/jobs/${realJob.slug}`)}
        />
        <SafetyNote />
      </div>
    </section>

    <section class="ds__section" aria-labelledby="filter-h">
      <h2 id="filter-h">Search and filters</h2>
      <p class="ds__note">Static states here; behaviour comes in GR-006.</p>
      <FilterBar>
        <SearchInput id="ds-q" label="Search openings" placeholder="Company, course or city" />
        <Select id="ds-sort" label="Sort" options={sortOptions} value="soon" />
        <div class="ds__row">
          <FilterChip label="Remote" pressed={false} />
          <FilterChip label="Job placement" pressed={true} />
          <FilterChip label="2:2 or any" pressed={false} />
        </div>
      </FilterBar>
      <div class="ds__stack">
        <ResultCount count={17} />
        <ResultCount count={1} />
        <ResultCount count={0} />
        <EmptyState clearHref="/design" />
      </div>
    </section>

    <section class="ds__section" aria-labelledby="skel-h">
      <h2 id="skel-h">Not built</h2>
      <p class="ds__note">
        SkeletonCard: lists render on the server and filter in place, so nothing loads on the client
        and no skeleton is needed (spec 7: "if any client loading is used").
      </p>
    </section>
  </div>
</Base>

<style>
  .ds {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
    padding-block: var(--space-6);
  }
  .ds__intro {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .ds__eyebrow,
  .ds__note,
  .ds__label {
    color: var(--color-ink-muted);
    font-size: var(--font-size-sm);
  }
  h1 {
    font-size: var(--font-size-2xl);
  }
  .ds__section {
    display: grid;
    gap: var(--space-3);
    border-top: var(--border-strong) solid var(--color-ink);
    padding-top: var(--space-4);
  }
  h2 {
    font-size: var(--font-size-xl);
  }
  .ds__swatches {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
  }
  .ds__swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .ds__chip {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    border: var(--border-thin) solid var(--color-ink);
  }
  .ds__type {
    line-height: var(--line-snug);
    overflow-wrap: anywhere;
  }
  .ds__display {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--weight-bold);
  }
  .ds__space {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .ds__bar {
    display: inline-block;
    height: var(--space-4);
    background: var(--color-primary);
  }
  .ds__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .ds__stack {
    display: grid;
    gap: var(--space-3);
    justify-items: stretch;
    max-width: var(--measure);
  }
  .ds__labelled {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
  }
  .ds__wide {
    justify-items: stretch;
  }
  .ds__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .ds__flat {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border-double) solid var(--color-ink);
  }
  code {
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }
</style>
