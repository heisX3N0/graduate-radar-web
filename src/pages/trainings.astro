---
// Trainings home (spec 6.1, 6.3): same pattern as jobs, with track, cost, format and
// job placement filters.
import FilterChip from '../components/FilterChip.astro';
import ListHead from '../components/ListHead.astro';
import ListingRow from '../components/ListingRow.astro';
import ListSection from '../components/ListSection.astro';
import ListLayout from '../components/ListLayout.astro';
import SearchInput from '../components/SearchInput.astro';
import Select from '../components/Select.astro';
import { getListings } from '../data/feed.ts';
import Base from '../layouts/Base.astro';
import { lagosToday } from '../lib/dates.ts';
import { COSTS, FORMATS, openOnly, sortListings } from '../lib/filters.ts';
import { distinct, jsonForScript, toTrainingItem } from '../lib/list-data.ts';
import { groupTrainings } from '../lib/sections.ts';

const { trainings, generatedAt } = await getListings();
const today = lagosToday();
const parsed = new Date(generatedAt);
const dataDay = Number.isNaN(parsed.getTime()) ? '' : lagosToday(parsed);

const open = sortListings(openOnly(trainings, today), 'soon');
const byKey = new Map(open.map((l) => [l.key, l]));
const sections = groupTrainings(open, today);

const tracks = distinct(trainings.map((t) => t.track));
const dataJson = jsonForScript({
  kind: 'trainings',
  items: open.map(toTrainingItem),
  options: { tracks },
});

const all = (label: string, values: readonly string[]) => [
  { value: '', label },
  ...values.map((v) => ({ value: v, label: v })),
];
const sortOptions = [
  { value: '', label: 'Closing soonest' },
  { value: 'new', label: 'Newest' },
];
---

<Base
  title="Free tech trainings and scholarships"
  description="Free and low-cost tech trainings and scholarships for Nigerian graduates: software, data, design, product, cloud, cybersecurity and AI."
  current="trainings"
>
  <ListHead
    heading="Free tech trainings"
    count={open.length}
    noun="training"
    source="provider"
    updated={dataDay}
  />
  <div class="page">
    <p class="page__other">
      Looking for jobs? <a href="/">See graduate jobs</a>
    </p>
    <ListLayout
      count={open.length}
      noun="training"
      clearHref="/trainings"
      dataJson={dataJson}
      filtersLabel="Search and filter trainings"
    >
      <Fragment slot="search">
        <SearchInput id="q" label="Search trainings" placeholder="Course, provider or skill" />
      </Fragment>
      <Fragment slot="filters">
        <Select id="track" label="Track" options={all('All tracks', tracks)} />
        <Select id="cost" label="Cost" options={all('Any cost', COSTS)} />
        <Select id="format" label="Format" options={all('Any format', FORMATS)} />
        <div class="page__chips">
          <FilterChip label="Job placement" pressed={false} name="place" />
        </div>
        <Select id="sort" label="Sort" options={sortOptions} />
      </Fragment>
      {sections.map((s) => (
        <ListSection id={s.id} label={s.label} urgent={s.urgent} count={s.keys.length}>
          {s.keys.map((key) => (
            <li data-key={key}>
              <ListingRow kind="training" listing={byKey.get(key)!} />
            </li>
          ))}
        </ListSection>
      ))}
    </ListLayout>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-4);
  }
  .page__other a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .page__other {
    font-size: var(--font-size-sm);
  }
  .page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
