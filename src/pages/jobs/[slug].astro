---
// Job detail (spec 6.1). One page per listing in the feed, including Closed ones checked
// in the last 60 days, so shared links show "This opening has closed" instead of a 404.
import DetailLayout from '../../components/DetailLayout.astro';
import EligibilityChecklist from '../../components/EligibilityChecklist.astro';
import { getListings, type JobListing } from '../../data/feed.ts';
import Base from '../../layouts/Base.astro';
import { lagosToday } from '../../lib/dates.ts';
import { jsonForScript } from '../../lib/list-data.ts';
import { eligibilityItems } from '../../lib/listing-text.ts';
import { jobDescription, jobPostingJsonLd, jobTitle, similarListings } from '../../lib/seo.ts';
import { absolute, siteOrigin } from '../../lib/site.ts';

export async function getStaticPaths() {
  const { jobs } = await getListings();
  const today = lagosToday();
  return jobs.map((listing) => ({
    params: { slug: listing.slug },
    props: { listing, today, similar: similarListings(listing, jobs, today, (j) => j.field) },
  }));
}

interface Props {
  listing: JobListing;
  similar: JobListing[];
  today: string;
}
const { listing, similar, today } = Astro.props;
const path = `/jobs/${listing.slug}`;
const ld = jobPostingJsonLd(listing, siteOrigin(Astro.site), today);
const place = [listing.location, listing.remote ? 'Remote' : ''].filter(Boolean).join(' · ');
---

<Base
  title={jobTitle(listing, today)}
  description={jobDescription(listing, today)}
  current="jobs"
  path={path}
  ogType="article"
  jsonLd={ld ? jsonForScript(ld) : undefined}
>
  <DetailLayout
    section={{ label: 'Jobs', href: '/' }}
    listing={listing}
    by={listing.organisation}
    kicker={`${listing.type} · ${listing.field}`}
    pageUrl={absolute(Astro.site, path)}
    today={today}
    similar={similar.map((j) => ({
      key: j.key,
      title: j.title,
      by: j.organisation,
      href: `/jobs/${j.slug}`,
      deadline: j.deadline,
    }))}
  >
    <section class="facts" aria-labelledby="where-h">
      <h2 id="where-h">Where</h2>
      <p>{place || 'Location not stated'}</p>
    </section>
    <section class="facts" aria-labelledby="who-h">
      <h2 id="who-h">Who can apply</h2>
      <EligibilityChecklist items={eligibilityItems(listing)} />
    </section>
    {listing.notes && (
      <section class="facts" aria-labelledby="notes-h">
        <h2 id="notes-h">Notes</h2>
        <p>{listing.notes}</p>
      </section>
    )}
  </DetailLayout>
</Base>

<style>
  .facts {
    display: grid;
    gap: var(--space-2);
  }
  .facts h2 {
    font-size: var(--font-size-lg);
  }
</style>
