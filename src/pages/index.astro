---
// Jobs home (spec 6.1, 6.3): heading, search and filters, and every open job in
// deadline sections (GR-015).
import FilterChip from '../components/FilterChip.astro';
import ListHead from '../components/ListHead.astro';
import ListingRow from '../components/ListingRow.astro';
import ListSection from '../components/ListSection.astro';
import ListLayout from '../components/ListLayout.astro';
import SearchInput from '../components/SearchInput.astro';
import Select from '../components/Select.astro';
import { getListings } from '../data/feed.ts';
import Base from '../layouts/Base.astro';
import { lagosToday } from '../lib/dates.ts';
import { LOCATIONS, openOnly, sortListings } from '../lib/filters.ts';
import { distinct, jsonForScript, toJobItem } from '../lib/list-data.ts';
import { groupJobs } from '../lib/sections.ts';

const { jobs, generatedAt } = await getListings();
const today = lagosToday();
const parsed = new Date(generatedAt);
const dataDay = Number.isNaN(parsed.getTime()) ? '' : lagosToday(parsed);

const open = sortListings(openOnly(jobs, today), 'soon');
const byKey = new Map(open.map((l) => [l.key, l]));
const sections = groupJobs(open, today);

const types = distinct(jobs.map((j) => j.type));
const fields = distinct(jobs.map((j) => j.field));
const dataJson = jsonForScript({
  kind: 'jobs',
  items: open.map(toJobItem),
  options: { types, fields },
});

const all = (label: string, values: readonly string[]) => [
  { value: '', label },
  ...values.map((v) => ({ value: v, label: v })),
];
const classOptions = [
  { value: '', label: 'Any (no filter)' },
  { value: '21', label: '2:1 or above' },
  { value: '22', label: '2:2' },
  { value: 'any', label: 'Third class or pass' },
];
const sortOptions = [
  { value: '', label: 'Closing soonest' },
  { value: 'new', label: 'Newest' },
];
---

<Base
  title="Graduate Radar"
  description="A free, checked list of graduate trainee programmes, internships, entry-level and NYSC roles for Nigerian graduates."
  current="jobs"
>
  <ListHead
    heading="Graduate jobs"
    count={open.length}
    noun="opening"
    source="employer"
    updated={dataDay}
  />
  <div class="page">
    <p class="page__other">
      Looking for free tech courses? <a href="/trainings">See trainings and scholarships</a>
    </p>
    <ListLayout
      count={open.length}
      noun="opening"
      clearHref="/"
      dataJson={dataJson}
      filtersLabel="Search and filter jobs"
    >
      <Fragment slot="search">
        <SearchInput id="q" label="Search jobs" placeholder="Company, role, city or course" />
      </Fragment>
      <Fragment slot="filters">
        <Select id="type" label="Type" options={all('All types', types)} />
        <Select id="field" label="Field" options={all('All fields', fields)} />
        <Select id="loc" label="Location" options={all('Anywhere', LOCATIONS)} />
        <Select id="class" label="Degree class I have" options={classOptions} />
        <div class="page__chips">
          <FilterChip label="Remote only" pressed={false} name="remote" />
        </div>
        <Select id="sort" label="Sort" options={sortOptions} />
      </Fragment>
      {sections.map((s) => (
        <ListSection id={s.id} label={s.label} urgent={s.urgent} count={s.keys.length}>
          {s.keys.map((key) => (
            <li data-key={key}>
              <ListingRow kind="job" listing={byKey.get(key)!} />
            </li>
          ))}
        </ListSection>
      ))}
    </ListLayout>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-4);
  }
  .page__other a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .page__other {
    font-size: var(--font-size-sm);
  }
  .page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
