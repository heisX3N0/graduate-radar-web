---
// Placeholder until the list page (GR-006), now in the chosen design (GR-005). Shows live
// counts to prove the build reads the feed, and the data's own date so a site stuck on
// the snapshot shows an old date.
import Hero from '../components/Hero.astro';
import SafetyNote from '../components/SafetyNote.astro';
import { getListings } from '../data/feed.ts';
import Base from '../layouts/Base.astro';
import { effectiveStatus, lagosToday } from '../lib/dates.ts';

const listings = await getListings();
const today = lagosToday();
const open = (items: { status: string; deadline: string }[]) =>
  items.filter((i) => effectiveStatus(i, today) !== 'Closed').length;
const openJobs = open(listings.jobs);
const openTrainings = open(listings.trainings);
const parsed = new Date(listings.generatedAt);
const dataDay = Number.isNaN(parsed.getTime()) ? '' : lagosToday(parsed);
---

<Base
  title="Graduate Radar"
  description="A free, checked list of graduate trainee programmes, entry-level jobs and free tech trainings for Nigerian graduates."
  current="jobs"
>
  <Hero updated={dataDay} />
  <div class="soon">
    <p>
      Open now: {openJobs} jobs and {openTrainings} trainings. The full list with search and filters
      is on its way.
    </p>
    <SafetyNote />
  </div>
</Base>

<style>
  .soon {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin-inline: auto;
  }
</style>
