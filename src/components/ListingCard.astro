---
// One listing in a list. The whole card links to the detail page; there is no Apply
// button here (owner decision: people read eligibility first). Order follows spec 6.2:
// badges, title, organisation, type and field, location, deadline, eligibility,
// then the Checked stamp.
import type { JobListing, TrainingListing } from '../data/feed.ts';
import { eligibilitySummary, statusBadges } from '../lib/listing-text.ts';
import DeadlineChip from './DeadlineChip.astro';
import StatusBadge from './StatusBadge.astro';
import StatusStamp from './StatusStamp.astro';

type Props =
  | { kind: 'job'; listing: JobListing; today: string }
  | { kind: 'training'; listing: TrainingListing; today: string };

const props = Astro.props;
const { listing, today } = props;
const href = `/${props.kind === 'job' ? 'jobs' : 'trainings'}/${listing.slug}`;
const badges = statusBadges(
  { ...listing, remote: props.kind === 'job' ? props.listing.remote : false },
  today,
);
const by = props.kind === 'job' ? props.listing.organisation : props.listing.provider;
const meta =
  props.kind === 'job'
    ? [props.listing.type, props.listing.field]
    : [props.listing.track, props.listing.cost, props.listing.format];
const place = props.kind === 'job' ? props.listing.location : props.listing.duration;
const summary =
  props.kind === 'job' ? eligibilitySummary(props.listing) : props.listing.eligibility;
---

<article class="card">
  {badges.length > 0 && (
    <ul class="card__badges" aria-label="Status">
      {badges.map((b) => (
        <li>
          <StatusBadge kind={b.kind} />
        </li>
      ))}
    </ul>
  )}
  <h3 class="card__title">
    <a class="card__link" href={href}>
      {listing.title}
    </a>
  </h3>
  <p class="card__by">{by}</p>
  <p class="card__meta">{meta.filter(Boolean).join(' · ')}</p>
  {place && <p class="card__place">{place}</p>}
  <DeadlineChip listing={listing} today={today} />
  {summary && <p class="card__elig">{summary}</p>}
  <StatusStamp date={listing.verifiedOn} />
</article>

<style>
  .card {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-surface);
    border-top: var(--border-strong) solid var(--color-ink);
    border-bottom: var(--border-thin) solid var(--color-rule);
  }
  .card__badges {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .card__title {
    font-size: var(--font-size-lg);
    line-height: var(--line-snug);
  }
  .card__link {
    color: var(--color-ink);
    text-decoration: none;
  }
  /* The whole card is the link's tap area; the title stays the link's name. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
  }
  .card__link:hover {
    text-decoration: underline;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:has(.card__link:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
  .card__by {
    font-weight: var(--weight-semibold);
  }
  .card__meta {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }
  .card__place,
  .card__elig {
    color: var(--color-ink-muted);
  }
  .card__elig {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
