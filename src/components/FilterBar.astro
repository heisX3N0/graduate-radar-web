---
// Holds the search box, the Filters toggle and the filters (GR-015): the first child
// (search) and a <details> toggle share the top row; everything else takes a full row
// below. With a label it is a named region; without one (for example inside a labelled
// search form) it is a plain container, so the page does not get two landmarks with the
// same name.
interface Props {
  label?: string;
}
const { label } = Astro.props;
const Tag = label ? 'section' : 'div';
---

<Tag class="filters" aria-label={label}>
  <slot />
</Tag>

<style>
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: var(--border-thin) solid var(--color-rule);
  }
  .filters > :global(*) {
    grid-column: 1 / -1;
  }
  .filters > :global(:first-child) {
    grid-column: 1;
  }
  .filters > :global(details) {
    grid-column: 2;
  }
</style>
