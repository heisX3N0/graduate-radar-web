---
// Similar open listings on a detail page, as the same rows the list pages use (GR-016).
// On a closed listing's page this is how people move on to something they can still
// apply for.
import type { JobListing, TrainingListing } from '../data/feed.ts';
import ListingRow from './ListingRow.astro';

interface Props {
  heading: string;
  similar: { kind: 'job'; items: JobListing[] } | { kind: 'training'; items: TrainingListing[] };
}
const { heading, similar } = Astro.props;
---

{similar.items.length > 0 && (
  <section class="similar" aria-labelledby="similar-h">
    <h2 id="similar-h">{heading}</h2>
    <ul>
      {similar.kind === 'job'
        ? similar.items.map((listing) => (
            <li>
              <ListingRow kind="job" listing={listing} />
            </li>
          ))
        : similar.items.map((listing) => (
            <li>
              <ListingRow kind="training" listing={listing} />
            </li>
          ))}
    </ul>
  </section>
)}

<style>
  .similar {
    display: grid;
  }
  h2 {
    padding-block: var(--space-2);
    border-top: var(--border-double) solid var(--color-ink);
    border-bottom: var(--border-thin) solid var(--color-ink);
    font-size: var(--font-size-lg);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
