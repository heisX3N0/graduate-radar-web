---
// Links to similar open listings on a detail page. On a closed listing's page this is
// how people move on to something they can still apply for.
import { shortDate } from '../lib/dates.ts';

interface Props {
  heading: string;
  items: { key: string; title: string; by: string; href: string; deadline: string }[];
}
const { heading, items } = Astro.props;
---

{items.length > 0 && (
  <section class="similar" aria-labelledby="similar-h">
    <h2 id="similar-h">{heading}</h2>
    <ul>
      {items.map((i) => (
        <li>
          <a href={i.href}>
            <strong>{i.title}</strong>
            <span class="similar__meta">
              {i.by}
              {shortDate(i.deadline) && ` · Closes ${shortDate(i.deadline)}`}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .similar {
    display: grid;
    gap: var(--space-2);
    border-top: var(--border-strong) solid var(--color-ink);
    padding-top: var(--space-4);
  }
  h2 {
    font-size: var(--font-size-lg);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  li + li {
    border-top: var(--border-thin) solid var(--color-rule);
  }
  a {
    display: grid;
    min-height: var(--tap-min);
    padding: var(--space-2) 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  a:hover strong {
    text-decoration: underline;
  }
  .similar__meta {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }
</style>
