---
// Every page ends with the trust basics and a link to Stay safe (acceptance criterion 7),
// and the WhatsApp channel (GR-013).
import { CHANNEL_URL } from '../lib/site.ts';
---

<footer class="footer">
  <div class="container footer__inner">
    <p>
      <strong>Never pay to apply.</strong> We don't hire or process applications. We gather openings
      in one place.
    </p>
    <p>We add new openings and mark closed ones as we find them.</p>
    <ul>
      <li>
        <a href="/stay-safe">Stay safe</a>
      </li>
      <li>
        <a href="/about">About Graduate Radar</a>
      </li>
      <li>
        <a href={CHANNEL_URL}>Follow Graduate Radar on WhatsApp</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-12);
    background: var(--color-neutral-bg);
    border-top: var(--border-strong) solid var(--color-ink);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }
</style>
