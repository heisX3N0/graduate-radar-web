---
// Where you are: "Jobs / Deloitte Academy". The last item is the current page.
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
const last = items.length - 1;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < last ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  /* One row: the links keep their full tap height; the current page (already the
     heading below) is cut short with an ellipsis instead of wrapping onto a second row. */
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }
  li {
    display: flex;
    align-items: center;
    flex: none;
  }
  li:last-child {
    flex: 1 1 auto;
    min-width: 0;
  }
  li + li::before {
    content: '/';
    margin-right: var(--space-2);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-primary);
  }
  [aria-current='page'] {
    display: block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>
