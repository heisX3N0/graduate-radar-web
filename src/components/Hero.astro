---
// One line on what this is, and when the data was last updated (no schedule: GR-011).
// `updated` is the data's own date (the feed's or the snapshot's), never the build date,
// so a site stuck on the snapshot shows an old date.
import { shortDate } from '../lib/dates.ts';

interface Props {
  updated: string;
  heading?: string;
}
const { updated, heading = 'Checked openings for Nigerian graduates' } = Astro.props;
const updatedText = shortDate(updated);
---

<section class="hero">
  <h1>{heading}</h1>
  <p class="hero__what">Graduate trainee programmes, entry-level jobs and free tech trainings.</p>
  {updatedText && <p class="hero__updated">Last updated {updatedText}</p>}
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-4);
    text-align: center;
  }
  h1 {
    font-size: var(--font-size-2xl);
  }
  .hero__what {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .hero__updated {
    font-style: italic;
    color: var(--color-ink-muted);
    font-size: var(--font-size-sm);
  }
</style>
