---
// The top of a list page (GR-015): a short heading set like a newspaper section, and one
// plain line with the count, where each listing was checked, and when the data was last
// updated. `updated` is the data's own date (the feed's or the snapshot's), never the
// build date (GR-011), so a site stuck on the snapshot shows an old date. No schedule.
// The list script updates the count on load, as listings close between builds.
import { shortDate } from '../lib/dates.ts';

interface Props {
  heading: string;
  count: number;
  /** Singular noun for the count: "opening" or "training". */
  noun: string;
  /** Whose page each listing was checked on: "employer" or "provider". */
  source: string;
  updated: string;
}
const { heading, count, noun, source, updated } = Astro.props;
const updatedText = shortDate(updated);
const counted = `${count} ${count === 1 ? noun : `${noun}s`}`;
---

<header class="head">
  <h1>{heading}</h1>
  <p class="head__lede">
    <span data-total>{counted}</span>, each checked on the {source}'s own page.
    {updatedText && ` Updated ${updatedText}.`}
  </p>
</header>

<style>
  .head {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4) var(--space-3);
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-tight);
  }
  .head__lede {
    max-width: var(--measure);
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }
</style>
