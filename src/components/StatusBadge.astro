---
// A filled label for an attribute of a listing: Closing soon, Remote, New this week.
// Badges are always filled and never outlined, so they cannot be mistaken for the
// outlined stamps (StatusStamp, DeadlineChip), which are marks made by Graduate Radar.
import { BADGE_TEXT, type BadgeKind } from '../lib/listing-text.ts';

interface Props {
  kind: BadgeKind;
  text?: string;
}
const { kind, text } = Astro.props;
---

<span class={`badge badge--${kind}`}>{text ?? BADGE_TEXT[kind]}</span>

<style>
  .badge {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--line-snug);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    border-radius: var(--radius-sm);
  }
  .badge--soon {
    background: var(--color-soon-bg);
    color: var(--color-soon);
  }
  .badge--new {
    background: var(--color-new-bg);
    color: var(--color-new);
  }
  .badge--remote {
    background: var(--color-neutral-bg);
    color: var(--color-ink);
  }
</style>
