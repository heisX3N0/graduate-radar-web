---
// A page-level notice. "closed" is used on detail pages of closed listings
// ("This opening has closed"), "warning" for scam warnings, "info" for anything else.
// Ruled like a public notice (GR-016): a double rule above, a single rule below, no fill
// and no side stripe. The closed title is the largest, in red, so it stays the clearest
// thing on a closed page.
interface Props {
  kind: 'info' | 'warning' | 'closed';
  title: string;
}
const { kind, title } = Astro.props;
---

<section class={`banner banner--${kind}`} aria-label={title}>
  <p class="banner__title">{title}</p>
  <div class="banner__body">
    <slot />
  </div>
</section>

<style>
  .banner {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border-double) double var(--color-ink);
    border-bottom: var(--border-thin) solid var(--color-ink);
    color: var(--color-ink);
  }
  .banner__title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--font-size-md);
    line-height: var(--line-snug);
  }
  .banner__body:empty {
    display: none;
  }
  .banner--warning .banner__title {
    color: var(--color-soon);
  }
  .banner--closed {
    border-top-width: var(--border-accent);
  }
  .banner--closed .banner__title {
    color: var(--color-soon);
    font-size: var(--font-size-xl);
  }
</style>
