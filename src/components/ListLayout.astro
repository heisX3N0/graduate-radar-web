---
// The body of a list page. On phones (GR-015): a link to the other list, search and the
// Filters toggle on one row, a result line, then the listing rows in sections
// (ListSection, passed in the default slot) and an empty state. From 960 px (GR-017) it is
// a broadsheet: the link and the filters, always open, in a left rail that stays in view,
// and the ledger beside it, with the "Never pay to apply" notice above the list. From
// 1200 px the notice moves to a right rail with three red flags and the WhatsApp channel.
// Each part is in the page once and placed by grid areas, in reading order (side, list,
// rail), so screen readers, keyboards and the no-JS page meet it once. Every open listing
// is rendered on the server, so the full list works without JavaScript;
// src/scripts/list-page.ts adds search, filters, sort, sections and URL state on top.
// The page passes its data block (JSON) for the script.
import EmptyState from './EmptyState.astro';
import FilterBar from './FilterBar.astro';
import ResultCount from './ResultCount.astro';
import SafetyNote from './SafetyNote.astro';
import { CHANNEL_URL } from '../lib/site.ts';

interface Props {
  count: number;
  noun: string;
  clearHref: string;
  dataJson: string;
  filtersLabel: string;
}
const { count, noun, clearHref, dataJson, filtersLabel } = Astro.props;
// Three of the red flags on Stay safe, each linking there for the rest.
const flags = [
  'Any request for money, by transfer, card or airtime',
  'A recruiter who only uses Gmail, Yahoo or WhatsApp',
  'Requests for your BVN, bank login, card PIN or OTP',
];
---

<div class="lists" data-list-page>
  <div class="lists__side">
    <p class="lists__other">
      <slot name="other" />
    </p>
    <form
      class="lists__filters"
      data-filters
      role="search"
      aria-label={filtersLabel}
      action={clearHref}
      method="get"
    >
      <FilterBar>
        <slot name="search" />
        <details class="lists__more" data-more>
          <summary>
            Filters <span class="lists__active" data-active></span>
            <span class="lists__marker" aria-hidden="true">
              ▸
            </span>
          </summary>
        </details>
        <div class="lists__more-body">
          <slot name="filters" />
        </div>
      </FilterBar>
    </form>
  </div>
  <!-- The result line is for screen readers until a filter or search is in use. -->
  <div class="lists__count visually-hidden" data-count>
    <ResultCount count={count} noun={noun} />
    <a class="lists__clear" href={clearHref} data-clear hidden>
      Clear filters
    </a>
  </div>
  <div class="lists__items" data-items>
    <slot />
    <ul class="lists__flat" data-flat hidden></ul>
  </div>
  <div class="lists__empty" data-empty data-clear hidden>
    <EmptyState clearHref={clearHref} />
  </div>
  <div class="lists__rail" data-rail>
    <SafetyNote />
    <div class="lists__rail-more">
      <section class="flags" aria-labelledby="flags-h">
        <h2 id="flags-h">Red flags</h2>
        <ul data-flags>
          {flags.map((f) => (
            <li>
              <a href="/stay-safe">{f}</a>
            </li>
          ))}
        </ul>
      </section>
      <p class="lists__channel">
        <a href={CHANNEL_URL}>Follow Graduate Radar on WhatsApp</a>
      </p>
    </div>
  </div>
</div>
<script type="application/json" id="list-data" set:html={dataJson} is:inline />
<script>
  import { initListPage } from '../scripts/list-page.ts';
  initListPage();
</script>

<style>
  .lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    max-width: var(--measure);
  }
  .lists__side {
    display: grid;
    gap: var(--space-4);
  }
  .lists__other {
    font-size: var(--font-size-sm);
  }
  .lists__other :global(a),
  .lists__channel a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .lists__count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  /* The Filters toggle sits beside the search box. Its panel is the next element, shown
     by CSS when the toggle is open, so the toggle never moves. */
  .lists__more > summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding-inline: var(--space-3);
    border: var(--border-strong) solid var(--color-ink);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .lists__marker {
    display: inline-block;
    transition: transform var(--duration-fast);
  }
  .lists__more[open] .lists__marker {
    transform: rotate(90deg);
  }
  .lists__active {
    color: var(--color-primary);
  }
  .lists__more-body {
    display: none;
    gap: var(--space-3);
  }
  .lists__more[open] + .lists__more-body {
    display: grid;
  }
  .lists__clear[hidden] {
    display: none;
  }
  .lists__clear {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  /* List rows switch to a location column when the list is wide enough (ListingRow). */
  .lists__items {
    container-type: inline-size;
  }
  .lists__flat {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border-double) solid var(--color-ink);
  }
  .lists__flat[hidden],
  .lists__flat > :global([hidden]) {
    display: none;
  }
  /* Phones and tablets keep the GR-015 page: no rails. */
  .lists__rail {
    display: none;
  }
  .flags {
    display: grid;
    gap: var(--space-1);
  }
  .flags h2 {
    padding-block: var(--space-2);
    border-bottom: var(--border-thin) solid var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .flags ul {
    list-style: none;
    padding: 0;
    font-size: var(--font-size-sm);
  }
  .flags li {
    border-bottom: var(--border-thin) solid var(--color-rule);
  }
  .flags a {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: var(--space-1);
    color: var(--color-ink);
  }
  .lists__channel {
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
  }

  /* From 960 px: filters rail and ledger; the notice sits above the list (GR-017). The
     side column spans every row and stays in view; the last row takes any spare height,
     so a tall rail never stretches the rows of a short list. */
  @media (min-width: 60rem) {
    .lists {
      max-width: none;
      grid-template-columns: var(--rail) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas:
        'side rail'
        'side count'
        'side items'
        'side empty';
      gap: var(--space-4) var(--space-6);
    }
    .lists__side {
      grid-area: side;
      align-self: start;
      position: sticky;
      top: var(--space-4);
    }
    .lists__count {
      grid-area: count;
    }
    .lists__items {
      grid-area: items;
    }
    .lists__empty {
      grid-area: empty;
    }
    .lists__rail {
      grid-area: rail;
      display: grid;
      gap: var(--space-4);
      align-self: start;
    }
    .lists__rail-more {
      display: none;
    }
    /* The filters are always open here: no Filters button. */
    .lists__more {
      display: none;
    }
    .lists__more-body {
      display: grid;
    }
  }

  /* From 1200 px: a right rail with the notice, red flags and the channel (GR-017). */
  @media (min-width: 75rem) {
    .lists {
      grid-template-columns: var(--rail) minmax(0, 1fr) var(--rail);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'side count rail'
        'side items rail'
        'side empty rail';
    }
    .lists__rail {
      position: sticky;
      top: var(--space-4);
    }
    .lists__rail-more {
      display: grid;
      gap: var(--space-4);
    }
  }
</style>
